SELECT ?s1 ?s2 
WHERE { 
 ?s1 geo:hasGeometry [ geo:asWKT ?o1 ] ;
    lgo:has_code "1001"^^xsd:integer . 
 ?s2 geo:hasGeometry [ geo:asWKT ?o2 ] ;
    lgo:has_code ?code2 .  
 FILTER(?code2>5000 && ?code2<6000 && ?code2 != 5260) .
 FILTER(geof:sfIntersects(?o1, ?o2)). 
} 

